# ==============================================================================
# Configurações de Ambiente do Microsserviço Backend (DocJourney)
# ==============================================================================

# Banco de Dados PostgreSQL (Produção / Homologação)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=docjourney_db
DB_USER=postgres
DB_PASSWORD=senha123

# Para testes rápidos sem PostgreSQL, defina:
# USE_SQLITE=true

# Mensageria RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Webhook para disparo externo de status
NOTIFIER_WEBHOOK_URL=https://api-mock.sicredi.local/webhook/status

# Execução do Worker RabbitMQ embutido no ciclo de vida do FastAPI (1 único terminal)
ENABLE_EMBEDDED_WORKER=true
