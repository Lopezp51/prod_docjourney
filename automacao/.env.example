# URL Base da API do Microsserviço de Backend
# Em desenvolvimento local: http://localhost:8000
# Em produção (Linux Server): http://microservico.sicredi.local:8000
MICROSERVICE_BASE_URL=http://localhost:8000

# Integração com OpenAPI v2 (Sicredi / Certisign)
